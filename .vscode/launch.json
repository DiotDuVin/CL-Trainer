{
  // F5 : compile puis lance trainer sous gdb (nécessite l'extension ms-vscode.cpptools).
  // Modifiez "args" pour déboguer une autre commande.
  "version": "0.2.0",
  "configurations": [
    {
      "name": "trainer check (gdb)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/debug/trainer",
      "args": ["--workspace", "/tmp/trainer-debug-ws", "check", "cpp.basics.hello"],
      "cwd": "${workspaceFolder}",
      "MIMode": "gdb",
      "setupCommands": [
        { "text": "-enable-pretty-printing", "ignoreFailures": true },
        { "description": "Suivre le père après fork() (sinon gdb peut suivre le fils)",
          "text": "-gdb-set follow-fork-mode parent", "ignoreFailures": true }
      ],
      "preLaunchTask": "make"
    },
    {
      "name": "tests unitaires (gdb)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/debug/unit_tests",
      "cwd": "${workspaceFolder}",
      "MIMode": "gdb",
      "preLaunchTask": "make test"
    }
  ]
}
